---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
    <span class="grid-overlay"></span>
    <span class="vignette"></span>
  </div>

  <div class="container hero-inner">
    <img
      src="/assets/pics/headshot.jpeg"
      alt="Portrait of Elliot Chen"
      class="hero-avatar"
      width="112"
      height="112"
      loading="eager"
    />
    <h1 class="hero-name">{SITE.name}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>

    <div class="hero-actions">
      <SocialLinks size={22} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background:
      radial-gradient(140% 120% at 50% -10%, rgba(124, 147, 168, 0.22), transparent 55%),
      radial-gradient(100% 100% at 100% 0%, rgba(147, 120, 168, 0.14), transparent 50%),
      linear-gradient(180deg, #11141a 0%, #0f1115 55%, #0c0e12 100%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    will-change: transform;
    mix-blend-mode: screen;
  }

  .orb-1 {
    width: 460px;
    height: 460px;
    top: -140px;
    left: -100px;
    background: radial-gradient(circle, rgba(120, 160, 200, 0.85), transparent 68%);
    opacity: 0.7;
    animation: drift-1 22s ease-in-out infinite;
  }

  .orb-2 {
    width: 380px;
    height: 380px;
    top: -80px;
    right: -120px;
    background: radial-gradient(circle, rgba(170, 120, 200, 0.7), transparent 68%);
    opacity: 0.6;
    animation: drift-2 26s ease-in-out infinite;
  }

  .orb-3 {
    width: 340px;
    height: 340px;
    bottom: -160px;
    left: 42%;
    background: radial-gradient(circle, rgba(110, 200, 170, 0.6), transparent 68%);
    opacity: 0.5;
    animation: drift-3 30s ease-in-out infinite;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at center, rgba(154, 163, 175, 0.16) 1px, transparent 1.4px);
    background-size: 30px 30px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 90% 80% at 50% 35%, transparent 40%, rgba(15, 17, 21, 0.85) 100%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(4.5rem, 14vh, 7.5rem);
    position: relative;
  }

  .hero-avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: 0 0 0 6px rgba(15, 17, 21, 0.6), 0 8px 30px rgba(0, 0, 0, 0.45);
  }

  .hero-name {
    margin-top: 1.4rem;
    font-size: clamp(2rem, 5vw, 3rem);
    background: linear-gradient(180deg, #ffffff 0%, #c8d0db 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    margin-top: 0.85rem;
    max-width: 540px;
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .hero-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  @keyframes drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, 40px) scale(1.08); }
  }

  @keyframes drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, 30px) scale(1.1); }
  }

  @keyframes drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -40px) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb { animation: none; }
  }
</style>

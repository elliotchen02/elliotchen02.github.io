---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <img
      src="/assets/pics/headshot.jpeg"
      alt="Portrait of Elliot Chen"
      class="hero-avatar"
      width="96"
      height="96"
      loading="eager"
    />
    <h1 class="hero-name">{SITE.name}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>

    <div class="hero-actions">
      <SocialLinks size={22} />
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .hero-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .hero-name {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hero-tagline {
    margin-top: 0.75rem;
    max-width: 540px;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
</style>

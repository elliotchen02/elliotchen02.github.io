---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackjackGame from '../components/BlackjackGame.astro';
---

<BaseLayout title="Playground">
  <section class="section playground">
    <div class="container">
      <div class="playground-head">
        <p class="playground-sub">
          A random collection of stuff. Get a dopamine hit while you're here.
        </p>
      </div>

      <BlackjackGame />
    </div>
  </section>
</BaseLayout>

<style>
  .playground {
    border-top: 1px solid var(--border);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .playground-head {
    margin-bottom: 2rem;
  }

  .playground-sub {
    color: var(--text-muted);
    max-width: var(--reading-width);
  }
</style>

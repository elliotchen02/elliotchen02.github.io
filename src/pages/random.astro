---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackjackGame from '../components/BlackjackGame.astro';
---

<BaseLayout title="Random">
  <section class="section arcade">
    <div class="container">
      <div class="arcade-head">
        <p class="arcade-sub">
          I like games. And (occasionally) gambling. Get a dopamine hit while you're here.
        </p>
      </div>

      <BlackjackGame />
    </div>
  </section>
</BaseLayout>

<style>
  .arcade {
    border-top: 1px solid var(--border);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .arcade-head {
    margin-bottom: 2rem;
  }

  .arcade-sub {
    color: var(--text-muted);
    max-width: var(--reading-width);
  }
</style>
